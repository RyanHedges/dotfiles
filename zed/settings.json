// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "OpenCode": {
      "type": "custom",
      "command": "opencode",
      "args": ["acp"],
      "env": {},
    },
  },
  "debugger": {
    "dock": "right",
  },
  "project_panel": {
    "hide_gitignore": false,
  },
  "edit_predictions": {
    "provider": "copilot",
    "disabled_globs": [
      "**/*.enc", // Any encrypted files
      "**/*.key", // Any key files (e.g., master.key, SSH keys, etc.)
      ".env*", // Any environment variable files
      "config/secrets.yml",
      "config/database.yml",
      "db/*.psql", // PostgreSQL dump files
      "db/*.pgsql", // Another common PostgreSQL dump format
      "db/*.sql", // Any SQL dump files (caution: could include non-sensitive data)
      "db/*.dump", // PostgreSQL dump files (binary format)
      "db/dumps/*", // Any structured dump directory
      ".git-credentials", // Git credentials file
      ".gitconfig", // Git user config (may contain auth tokens)
    ],
    "mode": "eager",
  },
  "agent": {
    "default_model": {
      "effort": "high",
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "default_profile": "ask",
    "model_parameters": [],
  },
  "vim_mode": true,
  "vertical_scroll_margin": 10,
  "relative_line_numbers": "enabled",
  "ui_font_size": 16,
  "buffer_font_size": null,
  "buffer_font_family": "mononoki",
  "inlay_hints": {
    "enabled": true,
  },
  "theme": {
    "mode": "system",
    "light": "Catppuccin Frappé",
    "dark": "Catppuccin Mocha",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Frappé",
    "dark": "Catppuccin Mocha",
  },
  "indent_guides": {
    "active_line_width": 3,
    "enabled": true,
    "coloring": "indent_aware",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "auto_install_extensions": {
    "ruby": true,
    "html": true,
    "catppuccin": true,
    "catppuccin-icons": true,
  },
  "languages": {
    "Ruby": {
      "language_servers": [
        "ruby-lsp",
        "rubocop",
        "!solargraph",
        "!steep",
        "!sorbet",
        "...",
      ],
    },
  },
  "lsp": {
    "ruby-lsp": {
      "settings": {
        "use_bundler": true,
      },
      "initialization_options": {
        "enabledFeatures": {
          "diagnostics": true,
        },
        "formatting": true,
      },
    },
    "rubocop": {
      "settings": {
        "use_bundler": true,
      },
      "initialization_options": {
        "safeAutocorrect": false,
      },
    },
  },
  "autosave": "on_window_change",
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": true,
    },
  },
  "terminal": {
    "blinking": "on",
  },
  "minimap": {
    "show": "auto",
  },
  "file_types": {
    "GitHub Actions": [".github/workflows/*.yml", ".github/workflows/*.yaml"],
  },

  // This isn't working but I don't want to keep debugging the searching right now
  // "file_scan_inclusions": ["./Gemfile.lock"],
  // "file_scan_exclusions": ["**/node_modules", "**/.ruby-lsp/"]
  // ^^^^not working?^^^
}
