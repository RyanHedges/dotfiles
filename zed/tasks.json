// Static tasks configuration.
//
// Example:
[
  {
    "label": "test $ZED_RELATIVE_FILE:$ZED_ROW",
    "command": "bundle exec rspec",
    "args": ["\"$ZED_RELATIVE_FILE:$ZED_ROW\""],
    "tags": ["ruby-test"],
  },
  {
    "label": "Open Changed Files (HEAD vs origin/master)",
    "command": "git",
    "args": [
      "diff --diff-filter=d --name-only $(git merge-base HEAD origin/master) HEAD | xargs zed",
    ],
    "description": "Compare current branch to origin/master, opening changed files in Zed",
    "hide": "on_success",
    "reveal": "no_focus",
  },
]
