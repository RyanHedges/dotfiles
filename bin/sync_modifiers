#!/usr/bin/env swift
import Foundation

// Reads macOS System Preferences for modifier key mappings.
// If Caps Lock is mapped to Control anywhere in the UI settings,
// it applies that mapping globally to all keyboards via hidutil.
// This ensures any external keyboard inherits the UI setting automatically.

// Magic numbers:
// 30064771129 (0x700000039) = Caps Lock
// 30064771296 (0x7000000E0) = Left Control

func isMapped() -> Bool {
    let task = Process()
    task.launchPath = "/usr/bin/defaults"
    task.arguments = ["-currentHost", "export", "-g", "-"]
    let pipe = Pipe()
    task.standardOutput = pipe
    task.launch()
    
    let data = pipe.fileHandleForReading.readDataToEndOfFile()
    
    guard let plist = try? PropertyListSerialization.propertyList(from: data, options: [], format: nil) as? [String: Any] else {
        fputs("Error: Could not parse plist data\n", stderr)
        return false
    }
    
    for (key, value) in plist {
        if key.contains("modifiermapping"), let mappings = value as? [[String: Any]] {
            for mapping in mappings {
                if let src = mapping["HIDKeyboardModifierMappingSrc"] as? Int, src == 30064771129,
                   let dst = mapping["HIDKeyboardModifierMappingDst"] as? Int, dst == 30064771296 {
                    return true
                }
            }
        }
    }
    return false
}

func runHidutil(clear: Bool) {
    let mappingString = clear ? "[]" : "[{\"HIDKeyboardModifierMappingSrc\":0x700000039,\"HIDKeyboardModifierMappingDst\":0x7000000E0}]"
    let jsonString = "{\"UserKeyMapping\":\(mappingString)}"
    
    let task = Process()
    task.launchPath = "/usr/bin/env"
    task.arguments = ["hidutil", "property", "--set", jsonString]
    task.launch()
    task.waitUntilExit()
}

if isMapped() {
    print("Caps Lock -> Control mapping found in System Settings. Applying globally via hidutil.")
    runHidutil(clear: false)
} else {
    print("Caps Lock -> Control mapping NOT found in System Settings. Clearing hidutil global mapping.")
    runHidutil(clear: true)
}
